<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Regression: toàn bộ test case. -->
<suite name="Dating Journal - Regression" parallel="methods" thread-count="3" data-provider-thread-count="3">
    <listeners>
        <listener class-name="com.datingjournal.listeners.TestListener"/>
        <listener class-name="com.datingjournal.listeners.RetryTransformer"/>
    </listeners>

    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.datingjournal.tests.*"/>
        </packages>
    </test>
</suite>
