# ==============================================================
# MẪU biến môi trường. Copy thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
# File `.env` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit.
# Thứ tự ưu tiên: -Dkey=... > biến môi trường OS > .env > config/{env}.properties
# ==============================================================

# Môi trường: prod | staging | dev  (chọn file config/<env>.properties)
ENV=prod

# Ghi đè tùy chọn (bỏ trống = dùng giá trị trong properties)
BASE_URL=
BROWSER=chrome
HEADLESS=false
# Khung nhìn: desktop (1440x900) | mobile (390x844)
VIEWPORT=desktop
TIMEOUT_SECONDS=15
RETRY_COUNT=0

# Tài khoản test (BẮT BUỘC)
TEST_EMAIL=
TEST_PASSWORD=
